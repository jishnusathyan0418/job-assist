# Use a separate database for this product. Never commit real credentials.
DATABASE_URL=postgresql+psycopg2://jobspace:change-me@localhost:5432/jobspace
# Owner connection for explicit migrations only, direct/unpooled preferred.
# MIGRATION_DATABASE_URL=postgresql+psycopg2://migration_owner:change-me@localhost:5432/jobspace
APP_ORIGIN=http://localhost:8000
COOKIE_SECURE=false
SESSION_HOURS=8
# Supported public Greenhouse company boards (up to 6), no API key needed.
GREENHOUSE_BOARDS=cloudflare,mongodb,databricks,stripe
# Optional broader search; register your own credentials with Adzuna.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Apply migrations explicitly before startup by default.
RUN_MIGRATIONS=false

# Public Ashby employer boards; Sarvam has Bengaluru roles. Up to 6.
ASHBY_BOARDS=sarvam,Meraki-Labs,ema

# Public Lever employer boards, up to 6.
LEVER_BOARDS=meesho
